SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key"
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"

# אופציונלי: בלי מפתח זה לוח השיעורים מ-Arbox פשוט לא יופיע, והאפליקציה
# ממשיכה לעבוד רגיל עם המשימות.
ARBOX_API_KEY = "your-arbox-api-key"

# עבור הצ'אטבוט (עוד לא נבנה)
OPENAI_API_KEY = "your-openai-api-key"

# גישה ל-Google Calendar: פתחו את קובץ ה-JSON שהורדתם מ-Google Cloud Console
# והעתיקו כל שדה לכאן כמו שהוא (כולל private_key, עם שלוש מרכאות כפולות כדי
# לשמר את שורות ה-PEM). זהה בדיוק בין מקומי (.streamlit/secrets.toml, מוגן
# ב-.gitignore) לענן (Streamlit Cloud -> Settings -> Secrets). ודאו שכל יומן
# רלוונטי שותף עם כתובת ה-client_email שמופיעה כאן.
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "your-private-key-id"
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""
client_email = "your-service-account@your-project.iam.gserviceaccount.com"
client_id = "your-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "your-cert-url"
universe_domain = "googleapis.com"
