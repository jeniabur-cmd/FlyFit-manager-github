SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_ANON_KEY = "your-anon-key"
SUPABASE_SERVICE_ROLE_KEY = "your-service-role-key"

# אופציונלי: בלי מפתח זה לוח השיעורים מ-Arbox פשוט לא יופיע, והאפליקציה
# ממשיכה לעבוד רגיל עם המשימות.
ARBOX_API_KEY = "your-arbox-api-key"

# עבור הצ'אטבוט (עוד לא נבנה)
OPENAI_API_KEY = "your-openai-api-key"

# גישה ל-Google Calendar: אל תכניסו את פרטי ה-Service Account כאן (מפתח פרטי
# מרובה-שורות שובר את תחביר ה-TOML בקלות) - שמרו את קובץ ה-JSON שהורדתם
# מ-Google Cloud Console כפי שהוא, בנתיב .streamlit/gcp_service_account.json
# (מוגן ב-.gitignore). ודאו שכל יומן רלוונטי שותף עם כתובת ה-client_email
# שבתוך אותו קובץ.
