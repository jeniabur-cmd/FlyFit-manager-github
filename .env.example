# העתיקו לקובץ .env (לא מוגן ע"י git - לעולם לא לקומט אותו עם ערכים אמיתיים)
# ומלאו את הערכים האמיתיים. python-dotenv (services/config.py) טוען את זה
# אוטומטית בעליית השרת.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# מחרוזת חיבור ישירה למסד הנתונים - רק ל-scripts/run_migrations.py, לא בשימוש
# ע"י שרת ה-Flask עצמו.
SUPABASE_DB_URL=postgresql://user:password@host:port/dbname

# אופציונלי: בלי מפתח זה לוח השיעורים מ-Arbox פשוט לא יופיע, והאפליקציה
# ממשיכה לעבוד רגיל עם המשימות.
ARBOX_API_KEY=your-arbox-api-key

# עבור הצ'אטבוט (עוזר תכנון)
OPENAI_API_KEY=your-openai-api-key

# גישה ל-Google Calendar: פתחו את קובץ ה-JSON שהורדתם מ-Google Cloud Console
# והדביקו אותו כאן כמחרוזת JSON תקינה בשורה אחת (בלי שבירות שורה בתוך
# private_key - שמרו את ה-\n כפי שהם מופיעים בקובץ ה-JSON המקורי, לא כשורה
# חדשה אמיתית). ודאו שכל יומן רלוונטי שותף עם כתובת ה-client_email שבפנים.
GCP_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"your-cert-url","universe_domain":"googleapis.com"}
